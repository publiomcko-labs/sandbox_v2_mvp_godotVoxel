# A0 native C++ bindings: use API generated by the exact custom Godot editor.
# Invoke from repository root: scons -C native platform=windows target=template_debug custom_api_file=<absolute-path>
import os
from pathlib import Path

env = Environment(tools=["default"], PLATFORM="")
env = SConscript("../third_party/godot-cpp/SConstruct", {"api_version": "4.7", "env": env})
if env["platform"] != "windows":
    Exit("A0 supports only windows x86_64; add platforms with independent validation.")
if not ARGUMENTS.get("custom_api_file"):
    Exit("custom_api_file is required: use the API exported by the locked custom Godot editor.")
env.Append(CPPPATH=[Dir("src").srcnode().abspath])
env.Append(CXXFLAGS=["/std:c++20"] if env["platform"] == "windows" else ["-std=c++20"])
sources = Glob("src/*.cpp")
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
if env["target"] not in ("template_debug", "template_release"):
    Exit("Build target must be template_debug or template_release")
# SCons treats a dotted architecture suffix as a file extension unless .dll is explicit.
output = "../godot/bin/" + env.subst("$SHLIBPREFIX") + "sandbox_native" + suffix + env.subst("$SHLIBSUFFIX")
library = env.SharedLibrary(target=output, source=sources)
Default(library)
